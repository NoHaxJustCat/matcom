    CASE INPUTS
    FOLLOWING ARE THE CARDS INPUT FOR THIS CASE

 CASEID BOREALIS                                                                 
 DIM M                                                                           
  $REFQ XCG=1.3,ROUGH=0.006,$                                                    
  $FLTCON ALPHA=0.,                                                              
  NMACH=1.,MACH=0.4,                                                             
  ALT=0.,                                                                        
  $END                                                                           
  $AXIBOD TNOSE=2.,                                                              
  POWER=0.4,                                                                     
  LNOSE=0.55,                                                                    
  DNOSE=0.1,                                                                     
  LCENTR=1.4,                                                                    
  DCENTR=0.1,                                                                    
  TAFT=0.,                                                                       
  LAFT=0.1,                                                                      
  DAFT=0.0698,                                                                   
  DEXIT=0.05,                                                                    
  $END                                                                           
  $PROTUB $END                                                                   
  $FINSET1 SECTYP=0.,                                                            
  SSPAN=0.,0.11,                                                                 
  CHORD=0.24,0.12,                                                               
  XLE=1.71,                                                                      
  SWEEP=28.6,                                                                    
  NPANEL=3.,                                                                     
  ZUPPER=0.00625,0.0125,                                                         
  LMAXU=0.3,0.3,                                                                 
  LFLATU=0.4,0.4,                                                                
  $END                                                                           
 PRINT GEOM BODY                                                                 
 PRINT AERO BODY                                                                 
 SAVE                                                                            
 NEXT CASE                                                                       
